{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schemas/delegation-payload.schema.json",
  "title": "PACT v1 Authority Delegation Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delegate_key_id",
    "delegate_label",
    "namespace_patterns",
    "event_type_patterns",
    "epoch",
    "lease",
    "allow_subdelegation",
    "max_subdelegation_depth",
    "capabilities"
  ],
  "properties": {
    "delegate_key_id": {
      "type": "string",
      "pattern": "^ed25519:sha256:[0-9a-f]{64}$"
    },
    "delegate_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "namespace_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true
    },
    "event_type_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before", "not_after"],
      "properties": {
        "not_before": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "not_after": {
          "type": ["string", "null"],
          "maxLength": 64
        }
      }
    },
    "allow_subdelegation": {
      "type": "boolean"
    },
    "max_subdelegation_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "commit",
          "checkpoint",
          "register_schema",
          "register_policy",
          "activate_policy",
          "delegate",
          "revoke",
          "advance_epoch"
        ]
      },
      "uniqueItems": true
    }
  }
}
