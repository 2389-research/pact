{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schemas/commit.schema.json",
  "title": "PACT v1 Signed Commit",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "body", "body_digest", "signature"],
  "properties": {
    "format": {
      "const": "pact/commit/v1"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "parents",
        "actor",
        "authority",
        "observed_at",
        "metadata",
        "events"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "correlation_id": {
          "type": "string",
          "maxLength": 255
        },
        "metadata": {
          "type": "object"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://pact.local/schemas/event.schema.json"
          }
        }
      }
    },
    "body_digest": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^ed25519:sha256:[0-9a-f]{64}$"
    },
    "eventRef": {
      "type": ["string", "null"],
      "pattern": "^pact:event:sha256:[0-9a-f]{64}#[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "label"],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/keyId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_ref", "epoch", "lease_ref"],
      "properties": {
        "delegation_ref": {
          "$ref": "#/$defs/eventRef"
        },
        "epoch": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "lease_ref": {
          "$ref": "#/$defs/eventRef"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key", "value"],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/keyId"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
